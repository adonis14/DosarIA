# DosarIA — environment variables
# Copy to .env.local (local) or set in your hosting provider's secret store (production).
# NEVER commit real values. None of these is exposed to the browser (no NEXT_PUBLIC_ prefix).
#
# Local development: `npm run env:local` generates .env.local from `supabase status`.

# Public base URL of the app (used in email links). Must be https:// in production.
APP_URL=http://localhost:3000

# Supabase project (EU region in production, e.g. Frankfurt eu-central-1).
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key — identifies the project; access is still governed by RLS.
SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key — SERVER ONLY. Bypasses RLS. Used solely by
# src/server/monitoring/check-case.ts, src/server/monitoring/scheduler.ts and src/server/dal/audit.ts.
SUPABASE_SECRET_KEY=

# Court data source. Only "mock" is functional in this MVP.
COURT_DATA_PROVIDER=mock
# Base date for simulated hearings (YYYY-MM-DD) and artificial latency for demos.
MOCK_COURT_ANCHOR_DATE=2026-12-12
MOCK_COURT_LATENCY_MS=300

# Future portal integration — keep disabled until separately approved (see SECURITY.md).
PORTAL_JUST_SOAP_ENDPOINT=https://portalquery.just.ro/query.asmx
PORTAL_JUST_INTEGRATION_APPROVED=false
# Minimum minutes between two portal checks of the same file (15–1440) and request timeout.
PORTAL_JUST_MIN_INTERVAL_MINUTES=60
PORTAL_JUST_TIMEOUT_MS=15000
# NOTE (2026-11-25): the HTTPS endpoint returns Cloudflare 525 and plain HTTP is refused
# by design, so the real provider reports "source unavailable" even if enabled.
# See docs/PORTAL-INTEGRATION.md before changing any PORTAL_JUST_* value.

# Automatic checks (smart schedule). Off by default. When enabled, a timer must
# POST to /api/internal/scheduled-checks every minute with
# "Authorization: Bearer <SCHEDULER_SECRET>" (locally: npm run scheduler).
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SCHEDULED_CHECKS_ENABLED=false
SCHEDULER_SECRET=
# Maximum cases checked per run (1–100).
SCHEDULER_BATCH_SIZE=20

# Future LLM summaries — all must stay false until EU processing, DPA and
# tenant authorization are verified (see SECURITY.md). The MVP ignores them.
AI_PROVIDER_ENABLED=false
AI_EU_PROCESSING_VERIFIED=false
AI_DPA_SIGNED=false

# Optional: fixed password for `npm run seed` (local demo only).
# DEMO_PASSWORD=
